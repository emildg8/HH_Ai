# Профиль DevOps — скопируйте в config/profiles/devops.env или config/devops.env
# cp config/profiles/devops.env.example config/profiles/devops.env

HH_PROFILE=devops
# Минус-слова в URL поиска (сужают выдачу; при пустой выдаче — оставьте пустым)
HH_SEARCH_EXCLUDE_TOKENS=senior,сеньор,lead,лид,1с,1c,разработчик,developer,android,kotlin,python,frontend,backend,тестировщик,ml engineer

HH_KEYWORDS_FILE=./config/search-keywords-devops.txt
HH_VACANCIES_QUEUE_FILE=./data/vacancies-devops.json
HH_AREA=113
HH_SEARCH_PERIOD=7
HH_SEARCH_ORDER_BY=publication_time

HH_SESSION_LIMIT=80
HH_PER_KEYWORD_LIMIT=25
HH_LLM_MAX_PER_RUN=30
HH_OPENROUTER_MAX_CALLS_PER_RUN=30
HH_SCORE_MODE=local-first

HH_OPEN_DELAY_MIN_MS=2000
HH_OPEN_DELAY_MAX_MS=3500
HH_LOCAL_SCORE_MIN=38

# Резюме на hh.ru: npm run devops:list-resumes → TITLE + HASH
HH_PROFILE_RESUME_TITLE=DevOps
# HH_PROFILE_RESUME_HASH=806e0f3aff10827b470039ed1f425243343537
