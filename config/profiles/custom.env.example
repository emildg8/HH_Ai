# Универсальный шаблон профиля — скопируйте под свою вакансию:
#   cp config/profiles/custom.env.example config/profiles/backend.env
#   npm run profile:init -- --id=backend

HH_PROFILE=custom
HH_KEYWORDS_FILE=./config/search-keywords.txt
HH_VACANCIES_QUEUE_FILE=./data/vacancies-queue.json
HH_AREA=113
HH_SEARCH_PERIOD=7
HH_SEARCH_ORDER_BY=publication_time

HH_SESSION_LIMIT=50
HH_PER_KEYWORD_LIMIT=20
HH_LLM_MAX_PER_RUN=25

HH_PROFILE_RESUME_TITLE=
# HH_PROFILE_RESUME_HASH=

# Исходный .md для PDF под вакансию (обязательно, если в CV/ несколько .md)
# HH_TAILOR_RESUME_BASE_FILE=resume.md
