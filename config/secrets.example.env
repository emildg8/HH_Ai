# Скопируйте в config/secrets.local.env (файл в .gitignore).
#
# ═══ БЫСТРЫЙ ВЫБОР РЕЖИМА ═══
# Скопируйте ОДИН пресет из config/presets/:
#   no-llm.env           — без API, локальная оценка
#   openrouter-free.env  — OpenRouter бесплатно (рекомендуется)
#   ollama.env           — только локальный Ollama
#   openrouter-then-ollama.env — гибрид
# Гид: docs/CONFIG-GUIDE.md
#
# ═══ OpenRouter (вариант B) ═══
# OpenRouter_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
#
# ═══ Ollama (вариант C) ═══
# HH_CUSTOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HH_CUSTOM_LLM_MODEL=llama3.2
# HH_OPENROUTER_MAX_CALLS_PER_RUN=0
#
# Проверка: npm run setup:check
