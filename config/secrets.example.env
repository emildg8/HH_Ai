# Скопируйте в config/secrets.local.env (файл в .gitignore).
#
# OpenRouter — оценка вакансий (по умолчанию только бесплатные модели, см. OPENROUTER.md)
# Формат без пробелов вокруг =
# OpenRouter_API_KEY=sk-or-v1-...
#
# Необязательно: модель (по умолчанию в коде — openrouter/free)
# OPENROUTER_MODEL=openrouter/free
# или явная бесплатная модель, например: OPENROUTER_MODEL=google/gemma-2-9b-it:free
# или другой free-id, например: OPENROUTER_MODEL=google/gemma-2-9b-it:free
#
# Только если осознанно нужны платные модели:
# OPENROUTER_ALLOW_PAID=1
# OPENROUTER_MODEL=...
#
# Локальный LLM (Ollama: см. docker-compose.yml → сервис ollama, затем `docker compose exec ollama ollama pull llama3.2`)
# С Node на хосте Windows:
# HH_CUSTOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HH_CUSTOM_LLM_MODEL=llama3.2
# Только Ollama, без вызовов OpenRouter: HH_OPENROUTER_MAX_CALLS_PER_RUN=0
# HH_CUSTOM_LLM_API_KEY=
# Порог успешных вызовов OpenRouter перед запасным LLM (если заданы оба)
# HH_OPENROUTER_MAX_CALLS_PER_RUN=30
