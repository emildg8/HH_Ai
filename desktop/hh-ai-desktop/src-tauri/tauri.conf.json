{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HH Ai",
  "version": "3.0.1",
  "identifier": "dev.hh-ai.dashboard",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../../scripts/desktop-bundle.mjs --bundle-node",
    "devUrl": "http://127.0.0.1:3849",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "HH Ai — очередь откликов",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundled/hh-ai/*": "hh-ai/",
      "bundled/node/*": "node/"
    },
    "shortDescription": "HH Ai — очередь откликов hh.ru",
    "longDescription": "Локальный дашборд и автоматизация откликов на hh.ru без облака.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
