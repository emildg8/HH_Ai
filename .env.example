# Каталог для persistent-профиля Chromium (относительно корня проекта или абсолютный путь)
HH_SESSION_DIR=./data/session

# Отклик в браузере: подстрока в названии резюме на hh.ru (например DevOps). См. config/devops.env
# HH_PROFILE_RESUME_TITLE=DevOps
# HH_PROFILE_RESUME_HASH=806e0f3aff10827b470039ed1f425243343537

# 1 — скрипты сбора/скана без окна. Батч откликов это не использует (см. HH_BATCH_HEADLESS)
# HH_HEADLESS=1
# HH_BATCH_HEADLESS=1 — батч полностью без окна (капча: перезапуск Chromium; на Windows ненадёжно)
# HH_BATCH_SKIP_OFF_TARGET=1 — пропуск нецелевых вакансий до открытия браузера (0 — отключить)
# HH_DAILY_DIGEST_TELEGRAM=1 — отправлять вечерний дайджест в Telegram (нужны TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID)

# Свёрнутое окно при видимом Chromium. Батч: по умолчанию 1; при капче — развернуть
# HH_BROWSER_BACKGROUND=1

# Быстрый отклик: fill вместо посимвольного ввода, короткие паузы (батч из дашборда включает по умолчанию)
# HH_FAST=1
# HH_FAST=0 — «человечный» режим (медленнее, иногда меньше подозрений у антибота)

# --- Локальный Telegram-бот (рекомендуется, без VPS) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...   # @BotFather
# TELEGRAM_CHAT_ID=123456789         # @userinfobot
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
# HH_DASHBOARD_URL=http://127.0.0.1:3849
# TELEGRAM_API_BASE=https://....workers.dev   # CF Worker (npm run telegram:setup-access)
# TELEGRAM_API_SECRET=...
# TELEGRAM_PROXY=socks5://127.0.0.1:7890       # универсальный SOCKS5
# npm run telegram:setup-access                # автонастройка доступа + автозапуск
# npm run telegram-bot                         # polling
# docs/TELEGRAM-BOT.md
#
# --- scan-telegram.mjs / дайджест ---
# HH_DAILY_DIGEST_TELEGRAM=1
#
# --- VPS webhook (опционально) — docs/DEPLOY-WISPBYTE.md, DEPLOY-VDSINA.md ---
# TELEGRAM_WEBHOOK_URL=https://...
# TELEGRAM_WEBHOOK_SECRET=...
# HH_REMOTE_STATS_URL=...
# HH_REMOTE_API_TOKEN=...
# HH_REMOTE_STATS_PUSH=1
# HH_HARVEST_TELEGRAM=1 — уведомление после harvest, если добавлено ≥ N вакансий (по умолчанию 50)
# HH_HARVEST_TELEGRAM_MIN=50
# HH_KEYWORDS=python,backend
# HH_SCAN_LIMIT=10
# HH_PAUSE_MS=2500
# HH_AREA=1

# --- open-vacancies.mjs: ключи в config/search-keywords.txt или свой файл ---
# HH_KEYWORDS_FILE=./config/search-keywords.txt
# HH_PER_KEYWORD_LIMIT=8
# Лимит вакансий за один запуск (если задан HH_SESSION_LIMIT, он важнее HH_MAX_TOTAL)
# HH_SESSION_LIMIT=7
# HH_MAX_TOTAL=7
# Пауза между открытием вакансий, мс (случайно в диапазоне)
# HH_OPEN_DELAY_MIN_MS=3000
# HH_OPEN_DELAY_MAX_MS=5000
# Джиттер после перехода на страницу поиска, мс
# HH_SEARCH_JITTER_MIN_MS=1000
# HH_SEARCH_JITTER_MAX_MS=2000
# Короткий джиттер после загрузки карточки вакансии, мс
# HH_POST_LOAD_JITTER_MIN_MS=200
# HH_POST_LOAD_JITTER_MAX_MS=800

# --- harvest.mjs + OpenRouter или свой LLM (см. config/OPENROUTER.md) ---
# Свой endpoint вместо OpenRouter для оценки (Ollama: http://127.0.0.1:11434/v1 + имя модели)
# HH_CUSTOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HH_CUSTOM_LLM_MODEL=llama3.2
# HH_CUSTOM_LLM_API_KEY=
# Сколько успешных вызовов OpenRouter до переключения на HH_CUSTOM_LLM (если оба настроены; пусто = 0, только локальный LLM)
# HH_OPENROUTER_MAX_CALLS_PER_RUN=30
# Сколько раз вызвать LLM за один harvest (остальные записи — парсинг без оценки; 0 = без LLM и без ключа)
# HH_LLM_MAX_PER_RUN=30
# OpenRouter_API_KEY=sk-or-v1-...
# Модель (в т.ч. из таблицы README на GitHub): например маршрут бесплатных моделей или :free
# OPENROUTER_MODEL=openrouter/free
# # OPENROUTER_MODEL=qwen/qwen3.6-plus-preview:free
# OPENROUTER_ALLOW_PAID=1
# DASHBOARD_PORT=3849

# Отдельный файл очереди (недельный батч и т.п.; иначе data/vacancies-queue.json)
# HH_VACANCIES_QUEUE_FILE=./data/vacancies-queue-week.json
# Период выдачи hh.ru: 7 = за последние 7 дней (неделя)
# HH_SEARCH_PERIOD: 0=за всё время, 1=сутки, 3, 7=неделя, 30=месяц (search_period на hh.ru)
# HH_SEARCH_PERIOD=7
# Минус-слова в тексте поиска hh.ru (через запятую). Пустая строка = отключено (см. config/devops.env)
# HH_SEARCH_EXCLUDE_TOKENS=senior,сеньор,lead,лид,1с,1c
# HH_SEARCH_SALARY=0
# Помечать вакансии с вероятной анкетой по фразам в описании при harvest (0 = отключить)
# HH_HARVEST_QUESTIONNAIRE_HINT=0

# Капча / anti-bot на hh.ru: скрипт ждёт, пока вы решите проверку в том же окне Chromium (в headless — ошибка с подсказкой).
# HH_CAPTCHA_WAIT_MS=600000
# HH_CAPTCHA_POLL_MS=2000

# Ollama (chat/completions): ограничить число слоёв на GPU (~половина от авто — подберите по логам `ollama serve`)
# HH_OLLAMA_NUM_GPU=20

# Анкета: по умолчанию ответы из папки CV/ (без LLM). LLM — только если явно включить:
# HH_QUESTIONNAIRE_LLM=1
# HH_QUESTIONNAIRE_LLM_PROSE=1   # при наличии ключа LLM для «расскажите»/Python/причина смены (0 — только эвристика)
# HH_QUESTIONNAIRE_OPENROUTER=1
# HH_QUESTIONNAIRE_AUTO=1
# HH_BATCH_QUESTIONNAIRE_AUTO=1   # батч: генерация и подстановка анкеты (0 — выкл.)
# HH_QUESTIONNAIRE_HIGH_SCORE_MIN=72  # более развёрнутые ответы LLM для вакансий с высоким баллом
# Кнопка «Авто-отклик» в дашборде включает HH_QUESTIONNAIRE_AUTO без переменной

# При отклонении в дашборде с комментарием (Тестировщик, Product Manager, Аналитик…) — сразу отклонять похожие pending
# HH_AUTO_REJECT_SIMILAR=0

# --- Сопроводительные (дашборд): сначала OpenRouter при наличии ключа; без COVER_LETTER_OPENROUTER_ONLY при сбое — HH_CUSTOM_LLM_* (см. README, config/OPENROUTER.md)
# Только OpenRouter, без запасного Ollama/LM Studio:
# COVER_LETTER_OPENROUTER_ONLY=1
# COVER_LETTER_VARIANT_COUNT=3
# COVER_LETTER_MAX_TOKENS=12000
# COVER_LETTER_STYLE_MAX_CHARS=8000
# COVER_LETTER_STYLE_QUEUE_ITEMS=6
# Двухфазная генерация: бриф вакансия↔CV, затем письма (0 — выключить)
# COVER_LETTER_TWO_PHASE=1
# Кэш брифа на карточке (мс, по умолчанию 14 дней): COVER_LETTER_BRIEF_CACHE_MS=1209600000
# Повтор LLM, если варианты не проходят проверку без автоподготовки: COVER_LETTER_QUALITY_RETRY=1
# COVER_LETTER_TEMPERATURE=0.48
# COVER_LETTER_RESPONSE_JSON=0
#   — отключить json_object, если локальная модель не поддерживает

# --- Playwright (harvest, отклик, синхр. hh.ru) ---
# По умолчанию bundled Chromium после: npx playwright install chromium  (проверка: npm run setup:check)
# Системный Chrome — только если bundled не подходит:
# HH_PLAYWRIGHT_CHANNEL=chrome

# Папка заметок/собеседований для импорта в дашборд и черновиков ответов в чат
# HH_INTERVIEW_DIR=D:\Dev\HH\hh\Интервью
