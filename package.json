{
  "name": "hh-ai",
  "version": "2.0.0",
  "description": "HH Ai — локальная автоматизация откликов на hh.ru (дашборд, LLM, батч, анкеты). https://github.com/emildg8/HH_Ai",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/emildg8/HH_Ai.git"
  },
  "homepage": "https://github.com/emildg8/HH_Ai#readme",
  "bugs": {
    "url": "https://github.com/emildg8/HH_Ai/issues"
  },
  "type": "module",
  "scripts": {
    "login": "node scripts/login.mjs",
    "apply": "node scripts/apply.mjs",
    "scan-tg": "node scripts/scan-telegram.mjs",
    "vacancies": "node scripts/open-vacancies.mjs",
    "harvest": "node scripts/harvest.mjs",
    "devops:harvest": "node scripts/run-devops-harvest.mjs",
    "devops:rescore": "node scripts/run-devops-rescore.mjs",
    "devops:reject-similar": "node scripts/run-devops-reject-similar.mjs",
    "cv:export": "node scripts/export-cv-docs.mjs",
    "devops:apply-batch": "node scripts/hh-apply-batch.mjs --use-pool-letters --tailor-resume",
    "devops:pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devops-pipeline.ps1",
    "search-and-score": "node scripts/harvest.mjs",
    "dashboard": "node scripts/dashboard-server.mjs",
    "devops:dashboard": "node scripts/dashboard-server.mjs",
    "devops:test-dashboard-ui": "node scripts/test-dashboard-ui.mjs",
    "devops:probe-questionnaire": "node scripts/probe-questionnaire.mjs",
    "devops:list-resumes": "node scripts/list-profile-resumes.mjs",
    "devops:audit-letters": "node scripts/run-devops-audit-letters.mjs",
    "devops:regenerate-letters": "node scripts/run-devops-regenerate-letters.mjs",
    "ollama:pull": "ollama pull llama3.2",
    "rescore-queue": "node scripts/rescore-queue.mjs",
    "score-openrouter-quota": "node scripts/score-openrouter-until-quota.mjs",
    "hh-fill-letter": "node scripts/hh-fill-response-letter.mjs",
    "hh-apply-chat": "node scripts/hh-apply-chat-letter.mjs",
    "probe-response": "node scripts/probe-vacancy-response.mjs",
    "codegen-hh": "node scripts/codegen-hh.mjs",
    "backup": "node scripts/backup.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:public": "node scripts/release-public.mjs",
    "export:public": "node scripts/export-public.mjs",
    "profile:init": "node scripts/profile-init.mjs",
    "profile:list": "node -e \"import('./lib/load-profile.mjs').then(m=>console.log(m.listProfiles()))\"",
    "verify:local": "node scripts/verify-local.mjs",
    "setup": "node scripts/setup-wizard.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "secrets:check": "node scripts/pre-push-secrets-check.mjs",
    "hooks:install": "node scripts/install-git-hooks-runner.mjs",
    "test:store-concurrency": "node scripts/test-store-concurrency.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "docs:screenshots": "node scripts/capture-demo-screenshots.mjs",
    "postinstall": "node -e \"console.log('HH Ai: npm run login && npm run dashboard  |  docs/QUICKSTART.md')\""
  },
  "dependencies": {
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.49.0"
  }
}
