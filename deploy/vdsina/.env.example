# Скопируйте на VPS в /opt/hh-ai-webhook/.env (chmod 600)
# Те же значения продублируйте в GitHub → Settings → Secrets (см. docs/DEPLOY-VDSINA.md)

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=случайная_строка_32_символа
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_ID=

# Публичный URL дашборда (если есть Cloudflare Tunnel с ПК)
# HH_DASHBOARD_URL=https://hh.example.com
# HH_REMOTE_API_TOKEN=опционально_если_добавите_на_дашборд

HH_DASHBOARD_PUBLIC_URL=http://127.0.0.1:3849
HH_VDSINA_APP_DIR=/opt/hh-ai-webhook
HH_VDSINA_DATA_DIR=/opt/hh-ai-webhook/data
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
